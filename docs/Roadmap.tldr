							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "to the :yaml and the icon becomes available"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
