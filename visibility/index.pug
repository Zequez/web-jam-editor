mixin FancyLink(link)
  a(href=link
    cursor-pointer h-6 m1 pt.3
    text="3" rounded-1 flex-cc 
    uppercase
    transition-200
    hover="bg-white/30 bg-gradient-to-br from-white/10 shadow-[0_1px_0] shadow-white/40 transition-0"
    tracking-wider font-mono font-semibold px3
    text-shadow="[0_1px_0_#0004]"
    gap-1.5
  )
    block


html(h-full)
  head(title="Ezequiel Adrián Schwartzman")
  body(bg-gray-900 flex-col min-h-full)
    div(h8.5 w-full bg-purple-500 flex text-white b-b-2 b-purple-900 )
      +FancyLink("https://gaia.webjam.world")
        span(mb.7) ◀
        span Gaia
      div(
        flex-grow text-center uppercase flex-cc
        font-mono font-semibold text-shadow="[0_1px_0_#000]"
        )
        | Ezequiel Adrián Schwartzman
      +FancyLink("https://gaia.webjam.world")
        span Gaia
        span(mb.7) ▶

    main(w-full px6)
      h1(text="16/24" text-center h-24 shrink-0 font-serif tracking-wider uppercase text-white) Visibility
      div(flex-grow w-full bg-white rounded-lg text-30 p2 flex)
        img(src="images/ezequiel-humano/sm.webp" h-100 rounded-2)
        div(flex-cc uppercase font-mono text-center w-full) Hey 
      div(bg-white mt6 rounded-4 text-center p6)
        div Soon my website and this default page will be the same.
        a(block text-blue-500 underline href="https://ezequielschwartzman.org") Ezequiel's old current website
      