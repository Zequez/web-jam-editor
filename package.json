  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite dev --port 3007",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "deploy": "gh-pages -d dist -b www",
    "publish": "bun run build && bun run deploy",
    "gen:icons": "bun run src-meta/setup-icons.ts && bun run src-meta/gen-icons-map.ts",
    "postinstall": "bun run gen:icons"
  },
