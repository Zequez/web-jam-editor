    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "^5.57.0",
    "svelte-codemirror-editor": "^2.1.0",
    "thememirror": "^2.0.1",
    "tldraw": "^5.4.2",
    "unocss": "^66.10.5",
