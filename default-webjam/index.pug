mixin EmojiFavicon(emoji)
  link(
    rel="icon"
    type="image/svg+xml"
    href=`data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${emoji}</text></svg>`
  )


mixin Page(name="")
  html(name=name)
    head
      +EmojiFavicon("🌈")
    body[flex-cc flex-col min-h-screen w-full bg-amber-200]
      nav[flex-cc h-12 w-full font-bold uppercase text-white b-amber-400 b-b bg-amber-300 gap-3]
        +Tab(name, "", "Home", "fa-house")
        +Tab(name, "about", "About", "fa-user")
      main[grow]
        block

mixin Tab(currentPath, tabPath, text, icon)
  a[px2 py1 rounded-1 ${tabPath === currentPath ? "bg-white/20" : ""}](href=tabPath)
    span[icon-${icon} text-2em mr2]
    = text

+Page()
  div[text-12] Hello world
  a[block text-blue underline](href="about") About page
  

+Page("about")
  div[text-12] About you
  p.
    You are pretty cool; probably.
  p
    | Pss, 
    a[text-blue underline](href="secret") enter here. 
  p
    a[text-blue underline text-8](href="https://ezequielschwartzman.org" target="_blank") Ezequiel was here

+Page("secret")
  div[text-12] Super secret page
  a[block text-blue underline](href=".") Go home