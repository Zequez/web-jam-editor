mixin SeedBox(seed)
  // This is only possible because Pug is compiled to HTML
  // BEFORE UnoCSS parses it! Isn't it neat?
  div(
    w-full aspect-square bg-linear-to-br
    p1
    from="white/20" rounded-2 flex-cc
    hover="scale-110 duration-0" transition-transform
    duration-1000
    shadow=`${seed}-600 [0_1.6px_0_0.8px]`
    class=`bg-${seed}-400 text-${seed}-300`

  )
    - svgPath = (() => { let h=[...seed].reduce((h,c)=>(h*31+c.charCodeAt(0))|0,0), n=5+(Math.abs(h)%6), p=[]; for(let i=0;i<n;i++){let a=i*2*Math.PI/n,r=35+Math.abs((h=h*1664525+1013904223|0))%20;p.push(`${50+Math.cos(a)*r} ${50+Math.sin(a)*r}`)} return `M${p.join(' L')}Z` })()
    svg(h-full w-full viewBox="0 0 100 100")
      path(d=svgPath fill="currentColor")


html
  head
    title Webjam Website
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="icon" type="image/webp" href="images/gaia/sm.webp")
  body(bg-black text-white p6 text-center)
    main(mx-auto max-w-screen-sm space-y-6)
      img(src="images/gaia.webp" w-full)
      div(bg-white rounded-1 text-12 font-mono text-black)
        | Hello world
      div(grid gap-3 cols-7)
        +SeedBox('red')
        +SeedBox('orange')
        +SeedBox('amber')
        +SeedBox('yellow')
        +SeedBox('lime')
        +SeedBox('green')
        +SeedBox('emerald')
        +SeedBox('teal')
        +SeedBox('cyan')
        +SeedBox('sky')
        +SeedBox('blue')
        +SeedBox('indigo')
        +SeedBox('violet')
        +SeedBox('purple')
        +SeedBox('fuchsia')
        +SeedBox('pink')
        +SeedBox('rose')
        +SeedBox('slate')
        +SeedBox('gray')
        +SeedBox('mist')
        +SeedBox('olive')

      div(uppercase text-center mt12 tracking-wider text-12 font-serif)
        | Visibility
      p(mb-6 -mt6 text-center) For the steward, in service of the future of this project
      div( sm:max-w-screen-sm -mx-6 sm:mx-0 sm:mx-auto relative)
        iframe(src="https://ezequielschwartzman.org" w-full h-500px)